{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agentic Session State",
  "description": "Defines the structure for tracking multi-agent session progress, phase transitions, and cost metrics.",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "current_phase": {
      "enum": ["ORIENT", "DESIGN", "BUILD", "REFINE", "VALIDATE", "RETROSPECTIVE", "COMPACTION", "COMPLETE"]
    },
    "cumulative_cost": {
      "type": "number",
      "description": "Total USD spent on tokens for this session."
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input": { "type": "integer" },
        "output": { "type": "integer" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": { "type": "string" },
          "agent_id": { "type": "string" },
          "artifact_path": { "type": "string" },
          "status": { "enum": ["PENDING", "COMPLETED", "FAILED"] },
          "cost": { "type": "number" },
          "human_approval": { "type": "boolean" }
        }
      }
    },
    "active_context": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["session_id", "current_phase"]
}
